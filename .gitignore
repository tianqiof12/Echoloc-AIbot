# 真实配置不进仓库：仓库里放的都是 CHANGE_ME 占位模板
.env
*.env
!*.env.example
server/llbot/llbot_config/config_*.json
!server/llbot/llbot_config/config.example.json

# 运行期产物
server/maibot/data/MaiMBot/*.db
server/maibot/data/MaiMBot/logs/*
!server/maibot/data/MaiMBot/logs/.gitkeep
**/__pycache__/
*.py[cod]
*.log
.DS_Store
Thumbs.db

# 本地私密配置（桌面端/面板）
local_env.bat
ui_settings.local.json

# 第三方插件的历史备份文件
*.bak.llbot
*.bak.llbot2

# 发布构建产物（走 Releases 附件，不进仓库历史）
dist/
